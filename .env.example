# ---- Server (apps/server) ----
# Port to listen on. Most hosts set PORT for you.
PORT=3001
# Optional: overrides PORT (useful when other tooling sets PORT for the client dev server).
# BLINDSHOT_PORT=3001
# Allowed browser origins when the client is hosted on a different domain (comma-separated). "*" = any.
CORS_ORIGIN=*
# Optional: path to a built client to serve from the same process (defaults to apps/client/dist).
# CLIENT_DIST=/app/apps/client/dist

# ---- Client (apps/client, read at build time by Vite) ----
# Where the client connects for online play. Leave unset to use the same origin in production
# and http://<host>:3001 in development.
# VITE_SERVER_URL=https://blindshot-server.example.com
